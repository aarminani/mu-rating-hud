{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tekken Resource Hub Mu Rating HUD",
  "mainBinaryName": "trhmu",
  "version": "0.1.0",
  "identifier": "app.murating.helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tekken Resource Hub Mu Rating HUD",
        "width": 440,
        "height": 278,
        "resizable": false,
        "maximizable": false,
        "theme": "Dark",
        "backgroundColor": "#14171d",
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false,
        "skipTaskbar": false
      },
      {
        "label": "toast",
        "create": false,
        "title": "Mu Rating HUD",
        "width": 392,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": [
      "THIRD_PARTY_NOTICES.txt"
    ],
    "publisher": "aarmani",
    "copyright": "Not affiliated with or endorsed by Bandai Namco Entertainment.",
    "shortDescription": "Shows your Wavu Wank Mu Rating in Tekken 8",
    "longDescription": "Reads your Mu Rating from a published Wavu Wank snapshot and hands it to the in-game MR badge. Makes no account, sends nothing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
