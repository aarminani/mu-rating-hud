{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the Mu Rating Helper window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-center",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    {
      "identifier": "core:webview:allow-internal-toggle-devtools",
      "allow": []
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://wank.wavu.wiki/*"
        },
        {
          "url": "https://x.com/6weetbix"
        },
        {
          "url": "https://tekkenresourcehub.com/*"
        },
        {
          "url": "https://linktr.ee/aarminani"
        }
      ]
    }
  ]
}
