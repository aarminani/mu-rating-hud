    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
